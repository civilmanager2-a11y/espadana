{
  "functions": {
    "api/contact.js": {
      "maxDuration": 90
    }
  },
  "rewrites": [
    {
      "source": "/sales",
      "destination": "https://espadana-sales-network.vercel.app/sales"
    },
    {
      "source": "/sales/:path*",
      "destination": "https://espadana-sales-network.vercel.app/sales/:path*"
    },
    {
      "source": "/shop",
      "destination": "https://espadana-shop.vercel.app/shop"
    },
    {
      "source": "/shop/:path*",
      "destination": "https://espadana-shop.vercel.app/shop/:path*"
    }
  ],
  "headers": [
    {
      "source": "/articles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/articles",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/articles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
